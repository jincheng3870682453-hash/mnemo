{
  "name": "mnemo-dsh-go",
  "version": "0.7.1",
  "private": false,
  "description": "mnemo 记忆库的 DSH Go 原生插件：输入框胶囊、状态条、记忆面板。App 只画 JSON，不执行代码。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22.19"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "记忆",
      "en": "Memory"
    },
    "icon": "note",
    "wants": [
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "remember",
          "label": {
            "zh": "记住这句",
            "en": "Remember"
          },
          "icon": "save"
        },
        {
          "id": "recall",
          "label": {
            "zh": "想起来",
            "en": "Recall"
          },
          "icon": "search"
        }
      ],
      "composer.strip": [
        {
          "id": "status",
          "icon": "note",
          "panel": "memory"
        }
      ],
      "panels": [
        {
          "id": "memory",
          "title": {
            "zh": "记忆",
            "en": "Memory"
          },
          "icon": "note",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "keywords": [
    "dsh-go",
    "dsh",
    "plugin",
    "memory",
    "mnemo"
  ],
  "license": "MIT",
  "author": "金呈",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jincheng3870682453-hash/mnemo.git",
    "directory": "dsh-go"
  },
  "homepage": "https://github.com/jincheng3870682453-hash/mnemo#readme"
}
