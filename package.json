{
  "name": "mnemo",
  "version": "0.1.0",
  "description": "Token-thrifty, human-like long-term memory for AI agents. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "mnemo": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "cli": "npm run build --silent && node dist/src/cli.js",
    "example": "npm run build --silent && node dist/examples/basic.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "llm",
    "agent",
    "memory",
    "context-engineering",
    "token-efficiency",
    "forgetting-curve",
    "prospective-memory",
    "rag"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  }
}
